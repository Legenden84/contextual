# Copy to .env.local and fill in. .env.local is gitignored (*.local).
# These are server-only: they have no VITE_ prefix, so Vite never sends them to the browser.

# --- Required -------------------------------------------------------------
# Azure AI Foundry → Deployments + Endpoint page.
AZURE_OPENAI_ENDPOINT=https://pdaazuregpt.openai.azure.com/
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-12-01-preview
# Deployment name (sent as `model` on each request), not the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra-code

# --- Optional -------------------------------------------------------------
# Display name of the underlying model. Defaults to the deployment name.
AZURE_OPENAI_MODEL_NAME=gpt-6-astra
# Upper bound for each reply. Default 16384, as in the Foundry sample.
AZURE_OPENAI_MAX_COMPLETION_TOKENS=16384
# Context window for the context bar (amber at 75%, red at 95%). Set it from the model card.
AZURE_OPENAI_CONTEXT_LIMIT=
# USD per 1M tokens for the cost estimate (Global Standard, short/standard context).
AZURE_OPENAI_INPUT_PRICE_PER_1M=10
AZURE_OPENAI_OUTPUT_PRICE_PER_1M=50
